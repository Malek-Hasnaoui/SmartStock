
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartStock</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartStock.styles.css" asp-append-version="true" />

    <style>
        .smart-navbar {
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            padding: 12px 0;
        }

            .smart-navbar .navbar-brand {
                color: white;
                font-size: 23px;
                font-weight: bold;
            }

            .smart-navbar .nav-link {
                color: rgba(255,255,255,0.9) !important;
                font-weight: 500;
                margin: 0 5px;
                transition: 0.2s;
            }

                .smart-navbar .nav-link:hover {
                    color: white !important;
                    background: rgba(255,255,255,0.15);
                    border-radius: 8px;
                }

            .smart-navbar .navbar-toggler {
                border-color: white;
            }

            .smart-navbar .navbar-toggler-icon {
                filter: brightness(0) invert(1);
            }

        main {
            min-height: 75vh;
        }

        footer {
            padding: 18px 0;
            margin-top: 30px;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg smart-navbar shadow">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    📦 SmartStock
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- HOME -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                🏠 Home
                            </a>
                        </li>

                        <!-- PRODUCTS -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="Index">
                                📦 Products
                            </a>
                        </li>

                        <!-- CATEGORIES -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Category"
                               asp-action="Index">
                                📁 Categories
                            </a>
                        </li>

                        <!-- STOCK ALERTS -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="LowStock">
                                ⚠️ Stock Alerts
                            </a>
                        </li>

                        <!-- PRIVACY -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <!-- LOGIN / REGISTER -->
                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>
    </header>

    <!-- PAGE CONTENT -->
    <div class="container mt-4">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- FOOTER -->
    <footer class="border-top text-muted">

        <div class="container text-center">

            &copy; 2026 - SmartStock |
            Inventory Management System

            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
