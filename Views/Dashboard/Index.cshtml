
@model SmartStock.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-welcome {
        background: linear-gradient(120deg, #1e40af, #4f46e5, #7c3aed);
        color: white;
        padding: 32px;
        border-radius: 18px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
    }

    .dashboard-welcome::after {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        right: -50px;
        top: -100px;
    }

    .dashboard-welcome h2 {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .dashboard-welcome p {
        color: rgba(255,255,255,.8);
        margin: 0;
    }

    .stat-card {
        background: white;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        padding: 23px;
        height: 100%;
        box-shadow: 0 4px 15px rgba(15,23,42,.035);
        transition: all .25s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(15,23,42,.08);
    }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .icon-blue {
        background: #eff6ff;
    }

    .icon-green {
        background: #f0fdf4;
    }

    .icon-purple {
        background: #f5f3ff;
    }

    .icon-orange {
        background: #fff7ed;
    }

    .stat-label {
        color: #8b95a5;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .stat-number {
        color: #172033;
        font-size: 30px;
        font-weight: 750;
        line-height: 1.2;
    }

    .stat-footer {
        color: #9ca3af;
        font-size: 12px;
        margin-top: 10px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        color: #172033;
        margin-bottom: 18px;
    }

    .inventory-value-card {
        background: white;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(15,23,42,.035);
        height: 100%;
    }

    .inventory-value {
        font-size: 32px;
        font-weight: 750;
        color: #2563eb;
        margin: 12px 0 5px;
    }

    .action-card {
        display: flex;
        align-items: center;
        gap: 15px;
        background: white;
        border: 1px solid #e9edf3;
        border-radius: 14px;
        padding: 18px;
        color: #172033;
        text-decoration: none;
        height: 100%;
        transition: all .2s ease;
    }

    .action-card:hover {
        border-color: #2563eb;
        transform: translateY(-3px);
        box-shadow: 0 7px 18px rgba(37,99,235,.08);
        color: #2563eb;
    }

    .action-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: #eff6ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .action-card h6 {
        font-weight: 700;
        margin: 0 0 4px;
    }

    .action-card small {
        color: #8b95a5;
    }

    @@media (max-width: 768px) {
        .dashboard-welcome {
            padding: 24px;
        }

        .dashboard-welcome h2 {
            font-size: 21px;
        }

        .stat-number {
            font-size: 25px;
        }
    }
</style>

<div class="container-fluid py-3">

    <!-- Welcome Header -->
    <div class="dashboard-welcome">
        <h2>Welcome to SmartStock 👋</h2>
        <p>
            Manage your inventory, monitor your stock and track your business performance.
        </p>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <!-- Total Products -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon icon-blue">📦</div>
                </div>

                <div class="stat-label">TOTAL PRODUCTS</div>
                <div class="stat-number">@Model.TotalProducts</div>

                <div class="stat-footer">
                    Products registered in your inventory
                </div>
            </div>
        </div>

        <!-- Total Categories -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon icon-green">📁</div>
                </div>

                <div class="stat-label">TOTAL CATEGORIES</div>
                <div class="stat-number">@Model.TotalCategories</div>

                <div class="stat-footer">
                    Categories available
                </div>
            </div>
        </div>

        <!-- Total Stock -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon icon-purple">📊</div>
                </div>

                <div class="stat-label">TOTAL STOCK</div>
                <div class="stat-number">@Model.TotalStock</div>

                <div class="stat-footer">
                    Total available quantity
                </div>
            </div>
        </div>

        <!-- Low Stock -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon icon-orange">⚠️</div>
                </div>

                <div class="stat-label">LOW STOCK ALERTS</div>
                <div class="stat-number">@Model.LowStockCount</div>

                <div class="stat-footer">
                    Products requiring attention
                </div>
            </div>
        </div>

    </div>

    <!-- Inventory Value -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-lg-7">
            <div class="inventory-value-card">

                <div class="d-flex align-items-center gap-2">
                    <span style="font-size:25px;">💰</span>
                    <h5 class="fw-bold mb-0">
                        Total Inventory Value
                    </h5>
                </div>

                <div class="inventory-value">
                    @Model.TotalStockValue.ToString("N2") TND
                </div>

                <p class="text-muted mb-0">
                    Total value calculated from product price multiplied by available quantity.
                </p>

            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="inventory-value-card d-flex flex-column justify-content-center">

                <h5 class="fw-bold mb-2">
                    Inventory Overview
                </h5>

                <p class="text-muted mb-3">
                    Keep track of your products and make sure your stock stays under control.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-primary align-self-start">
                    View All Products →
                </a>

            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="mb-3">

        <h5 class="section-title">Quick Actions</h5>

        <div class="row g-3">

            <div class="col-12 col-md-4">
                <a asp-controller="Product"
                   asp-action="Create"
                   class="action-card">

                    <div class="action-icon">➕</div>

                    <div>
                        <h6>Add New Product</h6>
                        <small>Add a product to your inventory</small>
                    </div>

                </a>
            </div>

            <div class="col-12 col-md-4">
                <a asp-controller="Category"
                   asp-action="Create"
                   class="action-card">

                    <div class="action-icon">📂</div>

                    <div>
                        <h6>Add New Category</h6>
                        <small>Organize your products</small>
                    </div>

                </a>
            </div>

            <div class="col-12 col-md-4">
                <a asp-controller="Product"
                   asp-action="LowStock"
                   class="action-card">

                    <div class="action-icon">⚠️</div>

                    <div>
                        <h6>View Stock Alerts</h6>
                        <small>Check products with low stock</small>
                    </div>

                </a>
            </div>

        </div>
    </div>

</div>
