﻿@{
ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-header {
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: white;
        padding: 35px;
        border-radius: 18px;
        margin-bottom: 25px;
    }

    .dashboard-card {
        background: white;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.07);
        height: 100%;
        transition: 0.2s;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
        }

    .dashboard-icon {
        font-size: 32px;
        margin-bottom: 15px;
    }

    .dashboard-number {
        font-size: 30px;
        font-weight: bold;
        margin-top: 10px;
    }

    .dashboard-card p {
        color: #64748b;
        margin-bottom: 0;
    }

    body.dark-mode .dashboard-card {
        background: #1e293b;
        color: #f1f5f9;
    }

        body.dark-mode .dashboard-card p {
            color: #cbd5e1;
        }
</style>

<div class="container py-3">

    <div class="dashboard-header">
        <h2>📊 SmartStock Dashboard</h2>
        <p class="mb-0">
            Welcome to your inventory management system.
        </p>
    </div>

    <div class="row g-4">

        <!-- Total Products -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-icon">📦</div>
                <p>Total Products</p>
                <div class="dashboard-number text-primary">
                    @ViewBag.TotalProducts
                </div>
            </div>
        </div>

        <!-- Total Categories -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-icon">📁</div>
                <p>Total Categories</p>
                <div class="dashboard-number text-success">
                    @ViewBag.TotalCategories
                </div>
            </div>
        </div>

        <!-- Total Stock -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-icon">📊</div>
                <p>Total Stock</p>
                <div class="dashboard-number text-info">
                    @ViewBag.TotalStock
                </div>
            </div>
        </div>

        <!-- Low Stock -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-icon">⚠️</div>
                <p>Low Stock Alerts</p>
                <div class="dashboard-number text-danger">
                    @ViewBag.LowStock
                </div>
            </div>
        </div>

    </div>

    <!-- Inventory Value -->
    <div class="dashboard-card mt-4">
        <h5>💰 Total Inventory Value</h5>

        <div class="dashboard-number text-primary">
            @(((decimal)ViewBag.TotalValue).ToString("N2")) TND
        </div>

        <p>Calculated from product price × available quantity.</p>
    </div>

    <!-- Quick Actions -->
    <div class="mt-4">
        <h4 class="mb-3">Quick Actions</h4>

        <a asp-controller="Product"
           asp-action="Create"
           class="btn btn-primary me-2 mb-2">
            + Add Product
        </a>

        <a asp-controller="Category"
           asp-action="Create"
           class="btn btn-success me-2 mb-2">
            + Add Category
        </a>

        <a asp-controller="Product"
           asp-action="LowStock"
           class="btn btn-warning mb-2">
            ⚠️ View Alerts
        </a>
    </div>

</div>