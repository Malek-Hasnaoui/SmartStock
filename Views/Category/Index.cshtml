@model IEnumerable<SmartStock.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<style>
    .category-page {
        padding: 30px 10px;
        background: #f5f7fc;
        min-height: 85vh;
        color: #252d48;
        transition: .3s;
    }

    .category-header {
        background: linear-gradient(120deg, #263c91, #7656d6);
        padding: 35px;
        border-radius: 20px;
        color: white;
        margin-bottom: 30px;
        box-shadow: 0 10px 25px rgba(50, 50, 120, .15);
    }

        .category-header h2 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .category-header p {
            opacity: .85;
            margin-bottom: 0;
        }

    .header-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-add-category, .btn-theme {
        background: white;
        color: #3949ab;
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: .3s;
    }

        .btn-add-category:hover, .btn-theme:hover {
            background: #edf0ff;
            color: #263c91;
            transform: translateY(-2px);
        }

    .category-count {
        background: rgba(255,255,255,.18);
        padding: 12px 18px;
        border-radius: 12px;
        display: inline-block;
        margin-top: 20px;
    }

    .category-card {
        background: white;
        border: none;
        border-radius: 17px;
        padding: 23px;
        height: 100%;
        box-shadow: 0 5px 20px rgba(30, 50, 100, .06);
        transition: .3s;
    }

        .category-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(30, 50, 100, .12);
        }

    .category-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        background: #eef0ff;
        margin-bottom: 18px;
    }

    .category-card h5 {
        color: #252d48;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .category-description {
        color: #7b849b;
        font-size: 14px;
        min-height: 45px;
    }

    .category-date {
        color: #929bb0;
        font-size: 12px;
        margin-top: 15px;
    }

    .category-actions {
        display: flex;
        gap: 8px;
        margin-top: 18px;
        padding-top: 15px;
        border-top: 1px solid #edf0f5;
    }

    .btn-edit, .btn-delete {
        flex: 1;
        text-align: center;
        padding: 9px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-edit {
        background: #eef0ff;
        color: #4c51bf;
    }

        .btn-edit:hover {
            background: #dfe3ff;
            color: #30358d;
        }

    .btn-delete {
        background: #fff0f0;
        color: #dc4545;
    }

        .btn-delete:hover {
            background: #ffe0e0;
            color: #b91c1c;
        }

    .empty-state {
        background: white;
        padding: 50px 20px;
        border-radius: 17px;
        text-align: center;
        color: #7b849b;
    }

    /* DARK MODE */

    .category-page.dark-mode {
        background: #111827;
        color: #f9fafb;
    }

    .dark-mode .category-card {
        background: #1f2937;
        box-shadow: 0 5px 20px rgba(0,0,0,.25);
    }

        .dark-mode .category-card h5 {
            color: #f9fafb;
        }

    .dark-mode .category-description {
        color: #cbd5e1;
    }

    .dark-mode .category-date {
        color: #94a3b8;
    }

    .dark-mode .category-icon {
        background: #374151;
    }

    .dark-mode .category-actions {
        border-top-color: #374151;
    }

    .dark-mode .empty-state {
        background: #1f2937;
        color: #cbd5e1;
    }

        .dark-mode .empty-state h4 {
            color: white;
        }

    .dark-mode .category-count {
        background: rgba(255,255,255,.12);
    }

    @@media (max-width: 576px) {
        .category-header {
            padding: 22px;
        }

        .header-buttons {
            width: 100%;
        }

        .btn-add-category, .btn-theme {
            flex: 1;
            text-align: center;
        }
    }
</style>

<div class="category-page">

    <div class="category-header">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div>
                <h2>📦 Category Management</h2>
                <p>Organize and manage your product categories easily.</p>

                <div class="category-count">
                    <strong>@Model.Count()</strong> Total Categories
                </div>
            </div>

            <div class="header-buttons">

                <button type="button" id="themeToggle" class="btn-theme">
                    🌙 Dark Mode
                </button>

                <a asp-action="Create" class="btn-add-category">
                    + Add New Category
                </a>

            </div>

        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var category in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="category-card">

                        <div class="category-icon">
                            📁
                        </div>

                        <h5>@category.Name</h5>

                        <p class="category-description">
                            @(string.IsNullOrWhiteSpace(category.Description)
                                ? "No description available."
                                : category.Description)
                        </p>

                        <div class="category-date">
                            📅 Created:
                            @category.CreatedAt.ToString("dd MMM yyyy")
                        </div>

                        <div class="category-actions">

                            <a asp-action="Edit"
                               asp-route-id="@category.Id"
                               class="btn-edit">
                                ✏️ Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@category.Id"
                               class="btn-delete">
                                🗑️ Delete
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 55px;">📂</div>

            <h4 class="mt-3">No Categories Yet</h4>

            <p>Start by adding your first product category.</p>

            <a asp-action="Create" class="btn btn-primary mt-2">
                + Create First Category
            </a>
        </div>
    }

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const themeToggle = document.getElementById("themeToggle");
        const categoryPage = document.querySelector(".category-page");

        if (!themeToggle || !categoryPage) return;

        // Restore saved theme
        const savedTheme = localStorage.getItem("smartstock-theme");

        if (savedTheme === "dark") {
            categoryPage.classList.add("dark-mode");
            themeToggle.innerHTML = "☀️ Light Mode";
        }

        // Toggle theme
        themeToggle.addEventListener("click", function () {

            categoryPage.classList.toggle("dark-mode");

            if (categoryPage.classList.contains("dark-mode")) {

                localStorage.setItem("smartstock-theme", "dark");
                themeToggle.innerHTML = "☀️ Light Mode";

            } else {

                localStorage.setItem("smartstock-theme", "light");
                themeToggle.innerHTML = "🌙 Dark Mode";

            }

        });

    });
</script>
