﻿@{
ViewData["Title"] = "Dashboard";
}

<style>
    .welcome {
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: white;
        padding: 35px;
        border-radius: 18px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
        height: 100%;
    }

        .stat-card h2 {
            font-size: 32px;
            font-weight: bold;
        }

    .stat-icon {
        font-size: 35px;
    }
</style>

<div class="welcome">
    <h1>Welcome to SmartStock 📦</h1>
    <p class="mb-0">
        Manage your inventory easily and efficiently.
    </p>
</div>

<div class="row g-4">

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon">📦</div>
            <p>Total Products</p>
            <h2 class="text-primary">@ViewBag.TotalProducts</h2>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon">📁</div>
            <p>Total Categories</p>
            <h2 class="text-success">@ViewBag.TotalCategories</h2>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon">📊</div>
            <p>Total Stock</p>
            <h2 class="text-info">@ViewBag.TotalStock</h2>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon">⚠️</div>
            <p>Low Stock Alerts</p>
            <h2 class="text-danger">@ViewBag.LowStock</h2>
        </div>
    </div>

</div>

<div class="stat-card mt-4">
    <h5>💰 Total Inventory Value</h5>
    <h2 class="text-primary">
        @(((decimal)ViewBag.TotalValue).ToString("N2")) TND
    </h2>
</div>

<div class="mt-4">
    <h4>Quick Actions</h4>

    <a asp-controller="Product"
       asp-action="Create"
       class="btn btn-primary me-2">
        + Add Product
    </a>

    <a asp-controller="Category"
       asp-action="Create"
       class="btn btn-success me-2">
        + Add Category
    </a>

    <a asp-controller="Product"
       asp-action="LowStock"
       class="btn btn-warning">
        View Alerts
    </a>
</div>