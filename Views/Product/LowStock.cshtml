@model List<SmartStock.Models.Product>

@{
    ViewData["Title"] = "Stock Alerts";

    var totalAlerts = Model.Count;
    var totalQuantity = Model.Sum(p => p.Quantity);
}

<style>
    .alerts-container {
        padding: 30px 15px;
    }

    .alerts-header {
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: white;
        padding: 30px;
        border-radius: 18px;
        margin-bottom: 25px;
        box-shadow: 0 8px 25px rgba(37, 99, 235, 0.2);
    }

        .alerts-header h2 {
            font-weight: 700;
            margin-bottom: 8px;
        }

    .stat-card {
        background: white;
        padding: 22px;
        border-radius: 15px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.07);
        margin-bottom: 20px;
    }

        .stat-card h3 {
            font-size: 28px;
            font-weight: bold;
            margin: 10px 0 0;
        }

    .alert-table {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.07);
    }

        .alert-table table {
            margin-bottom: 0;
            vertical-align: middle;
        }

    .product-name {
        font-weight: 600;
    }

    .quantity-danger {
        color: #dc2626;
        font-weight: bold;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
        background: white;
        border-radius: 15px;
    }

        .empty-state .emoji {
            font-size: 55px;
            margin-bottom: 15px;
        }

    body.dark-mode .stat-card,
    body.dark-mode .alert-table,
    body.dark-mode .empty-state {
        background: #1e293b;
        color: #f1f5f9;
    }

    body.dark-mode .table {
        color: #f1f5f9;
    }

        body.dark-mode .table td,
        body.dark-mode .table th {
            border-color: #475569;
        }

    body.dark-mode .text-muted {
        color: #cbd5e1 !important;
    }

    @@media (max-width: 768px) {
        .alerts-header {
            padding: 22px;
        }

        .alert-table {
            overflow-x: auto;
        }
    }
</style>

<div class="container alerts-container">

    <!-- Header -->
    <div class="alerts-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2>⚠️ Stock Alerts</h2>
                <p class="mb-0">
                    Monitor products that need restocking.
                </p>
            </div>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-light fw-bold">
                ← Back to Products
            </a>
        </div>
    </div>

    <!-- Statistics -->
    <div class="row">

        <div class="col-md-6">
            <div class="stat-card">
                <div class="text-muted">Products with low stock</div>
                <h3 class="text-danger">@totalAlerts</h3>
                <small class="text-muted">
                    Products requiring attention
                </small>
            </div>
        </div>

        <div class="col-md-6">
            <div class="stat-card">
                <div class="text-muted">Remaining quantity</div>
                <h3 class="text-primary">@totalQuantity</h3>
                <small class="text-muted">
                    Total units in low-stock products
                </small>
            </div>
        </div>

    </div>

    <!-- Alerts Table -->
    <div class="alert-table">

        <h4 class="mb-4">Low Stock Products</h4>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="emoji">✅</div>
                <h4>All Stock Levels Are Healthy!</h4>
                <p class="text-muted">
                    No products currently require restocking.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-primary mt-2">
                    View Products
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Available</th>
                            <th>Minimum Stock</th>
                            <th>Missing Units</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td class="product-name">
                                    @product.Name
                                </td>

                                <td>
                                    @product.Category?.Name
                                </td>

                                <td class="quantity-danger">
                                    @product.Quantity
                                </td>

                                <td>
                                    @product.MinimumStock
                                </td>

                                <td>
                                    @(Math.Max(0, product.MinimumStock - product.Quantity))
                                </td>

                                <td>
                                    <span class="badge bg-danger">
                                        Low Stock
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>

</div>
