@model List<SmartStock.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<style>
    .products-page {
        padding: 10px 0 30px;
    }

    .products-header {
        background: linear-gradient(120deg, #1e40af, #4f46e5, #7c3aed);
        color: white;
        padding: 30px;
        border-radius: 18px;
        margin-bottom: 25px;
    }

        .products-header h2 {
            font-weight: 750;
            margin-bottom: 7px;
        }

        .products-header p {
            color: rgba(255,255,255,.8);
            margin: 0;
        }

    .products-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e9edf3;
        border-radius: 14px;
        padding: 20px;
    }

        .summary-card span {
            color: #8b95a5;
            font-size: 13px;
            font-weight: 600;
        }

        .summary-card h3 {
            font-size: 27px;
            font-weight: 750;
            margin: 8px 0 0;
            color: #172033;
        }

    .products-panel {
        background: white;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(15,23,42,.035);
    }

    .panel-header {
        padding: 22px;
        border-bottom: 1px solid #e9edf3;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

        .panel-header h5 {
            font-weight: 750;
            margin: 0;
            color: #172033;
        }

    .search-box {
        position: relative;
        max-width: 300px;
        width: 100%;
    }

        .search-box input {
            width: 100%;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            border-radius: 10px;
            padding: 10px 14px 10px 38px;
            outline: none;
            font-size: 13px;
        }

            .search-box input:focus {
                border-color: #2563eb;
                background: white;
            }

    .search-icon {
        position: absolute;
        left: 13px;
        top: 9px;
        color: #94a3b8;
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

        .products-table thead {
            background: #f8fafc;
        }

        .products-table th {
            color: #8b95a5;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 15px 18px;
            white-space: nowrap;
        }

        .products-table td {
            padding: 16px 18px;
            border-top: 1px solid #f0f2f5;
            color: #475569;
            font-size: 13px;
            vertical-align: middle;
        }

        .products-table tbody tr:hover {
            background: #f8fafc;
        }

    .product-identity {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .product-avatar {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        font-size: 19px;
        flex-shrink: 0;
    }

    .product-title {
        font-weight: 700;
        color: #172033;
        margin-bottom: 3px;
    }

    .product-description {
        color: #94a3b8;
        font-size: 11px;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .stock-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .stock-low {
        background: #fef2f2;
        color: #dc2626;
    }

    .stock-normal {
        background: #f0fdf4;
        color: #16a34a;
    }

    .price-text {
        font-weight: 700;
        color: #172033;
        white-space: nowrap;
    }

    .quantity-text {
        font-weight: 700;
        color: #334155;
    }

    .table-actions {
        display: flex;
        gap: 7px;
    }

        .table-actions a {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
        }

    .edit-action {
        color: #2563eb;
        background: #eff6ff;
    }

    .delete-action {
        color: #dc2626;
        background: #fef2f2;
    }

    .edit-action:hover {
        background: #dbeafe;
    }

    .delete-action:hover {
        background: #fee2e2;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

        .empty-state .empty-icon {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .empty-state h5 {
            font-weight: 700;
            color: #172033;
        }

        .empty-state p {
            color: #94a3b8;
        }

    .products-footer {
        padding: 17px 22px;
        border-top: 1px solid #e9edf3;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

        .products-footer small {
            color: #94a3b8;
        }

    @@media (max-width: 768px) {
        .products-summary {
            grid-template-columns: 1fr;
        }

        .products-header {
            padding: 22px;
        }

        .panel-header {
            align-items: stretch;
        }

        .search-box {
            max-width: none;
        }
    }
</style>

<div class="container-fluid products-page">

    <!-- Header -->
    <div class="products-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2>Products Management</h2>
                <p>Manage your products, prices and stock levels.</p>
            </div>

            <a asp-controller="Product"
               asp-action="Create"
               class="btn btn-light fw-bold px-4 py-2">
                + Add New Product
            </a>
        </div>
    </div>

    @{
        var totalProducts = Model?.Count ?? 0;
        var lowStockCount = Model?.Count(p => p.Quantity <= p.MinimumStock) ?? 0;
        var normalStockCount = totalProducts - lowStockCount;
    }

    <!-- Summary -->
    <div class="products-summary">

        <div class="summary-card">
            <span>TOTAL PRODUCTS</span>
            <h3>@totalProducts</h3>
        </div>

        <div class="summary-card">
            <span>STOCK NORMAL</span>
            <h3 style="color:#16a34a;">@normalStockCount</h3>
        </div>

        <div class="summary-card">
            <span>LOW STOCK</span>
            <h3 style="color:#dc2626;">@lowStockCount</h3>
        </div>

    </div>

    <!-- Products Table -->
    <div class="products-panel">

        <div class="panel-header">
            <h5>All Products</h5>

            <div class="search-box">
                <span class="search-icon">⌕</span>
                <input type="text"
                       id="productSearch"
                       placeholder="Search products or categories..." />
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h5>No Products Found</h5>
                <p>Your inventory is empty. Start by adding your first product.</p>

                <a asp-action="Create" class="btn btn-primary">
                    + Add Product
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="products-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Minimum</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="productsTableBody">

                        @foreach (var product in Model)
                        {
                            <tr class="product-row">

                                <td>
                                    <div class="product-identity">
                                        <div class="product-avatar">📦</div>
                                        <div>
                                            <div class="product-title">
                                                @product.Name
                                            </div>
                                            <div class="product-description">
                                                @product.Description
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @(product.Category?.Name ?? "Uncategorized")
                                </td>

                                <td>
                                    <span class="price-text">
                                        @product.Price.ToString("N2") TND
                                    </span>
                                </td>

                                <td>
                                    <span class="quantity-text">
                                        @product.Quantity
                                    </span>
                                </td>

                                <td>
                                    @product.MinimumStock
                                </td>

                                <td>
                                    @if (product.Quantity <= product.MinimumStock)
                                    {
                                        <span class="stock-badge stock-low">
                                            ⚠ Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge stock-normal">
                                            ✓ Normal
                                        </span>
                                    }
                                </td>

                                <td>
                                    @product.CreatedAt.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="edit-action"
                                           title="Edit Product">
                                            ✏️
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@product.Id"
                                           class="delete-action"
                                           title="Delete Product">
                                            🗑️
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div id="noSearchResults" class="empty-state" style="display:none;">
                <div class="empty-icon">🔎</div>
                <h5>No matching products</h5>
                <p>Try another product name or category.</p>
            </div>
        }

        <div class="products-footer">
            <small>
                Showing <strong id="visibleCount">@totalProducts</strong>
                of @totalProducts products
            </small>

            <a asp-controller="Product"
               asp-action="LowStock"
               class="btn btn-warning btn-sm fw-bold">
                ⚠ View Stock Alerts
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("productSearch");

        if (searchInput) {
            searchInput.addEventListener("input", function () {
                const searchValue = this.value.toLowerCase().trim();
                const rows = document.querySelectorAll(".product-row");

                let visible = 0;

                rows.forEach(row => {
                    const matches = row.textContent.toLowerCase().includes(searchValue);

                    row.style.display = matches ? "" : "none";

                    if (matches) {
                        visible++;
                    }
                });

                document.getElementById("visibleCount").textContent = visible;

                const noResults = document.getElementById("noSearchResults");

                if (noResults) {
                    noResults.style.display = visible === 0 ? "block" : "none";
                }
            });
        }
    </script>
}
