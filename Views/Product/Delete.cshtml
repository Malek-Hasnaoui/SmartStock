@model SmartStock.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<style>
    .delete-page {
        max-width: 700px;
        margin: 0 auto;
        padding: 35px 0;
    }

    .delete-card {
        background: white;
        border: 1px solid #e9edf3;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15,23,42,.06);
    }

    .delete-banner {
        background: linear-gradient(120deg, #991b1b, #dc2626);
        color: white;
        padding: 28px;
        text-align: center;
    }

    .warning-icon {
        width: 75px;
        height: 75px;
        background: rgba(255,255,255,.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 15px;
    }

    .delete-banner h3 {
        font-weight: 750;
        margin-bottom: 7px;
    }

    .delete-banner p {
        color: rgba(255,255,255,.8);
        margin: 0;
        font-size: 13px;
    }

    .delete-content {
        padding: 30px;
    }

    .warning-message {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        border-radius: 11px;
        padding: 14px 16px;
        font-size: 13px;
        margin-bottom: 25px;
    }

    .product-details {
        border: 1px solid #e9edf3;
        border-radius: 13px;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .product-details-header {
        background: #f8fafc;
        padding: 17px 20px;
        border-bottom: 1px solid #e9edf3;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .product-avatar {
        width: 45px;
        height: 45px;
        background: #eff6ff;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .product-details-header h5 {
        color: #172033;
        font-weight: 750;
        margin: 0 0 4px;
    }

    .product-details-header small {
        color: #94a3b8;
    }

    .details-list {
        padding: 8px 20px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 0;
        border-bottom: 1px solid #f1f3f6;
        gap: 15px;
        font-size: 13px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #8b95a5;
        font-weight: 550;
    }

    .detail-value {
        color: #172033;
        font-weight: 700;
        text-align: right;
    }

    .delete-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 12px 23px;
        font-weight: 650;
        font-size: 13px;
    }

        .btn-delete:hover {
            background: #b91c1c;
            color: white;
        }

    .btn-cancel {
        background: white;
        border: 1px solid #e2e8f0;
        color: #64748b;
        border-radius: 9px;
        padding: 12px 23px;
        font-weight: 650;
        font-size: 13px;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f8fafc;
            color: #334155;
        }

    @@media (max-width: 576px) {
        .delete-content {
            padding: 20px;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

            .delete-actions button,
            .delete-actions a {
                width: 100%;
                text-align: center;
            }
        }

    body.dark-mode .delete-card,
    body.dark-mode .product-details {
        background: #151f32;
        border-color: #263449;
        color: #f1f5f9;
    }

    body.dark-mode .product-details-header {
        background: #1e293b;
        border-color: #263449;
    }

    body.dark-mode .product-details-header h5,
    body.dark-mode .detail-value {
        color: #f1f5f9;
    }

    body.dark-mode .details-list,
    body.dark-mode .detail-row {
        border-color: #263449;
    }

    body.dark-mode .detail-label {
        color: #94a3b8;
    }

    body.dark-mode .product-avatar {
        background: #263449;
    }

    body.dark-mode .warning-message {
        background: #3b1720;
        border-color: #7f1d1d;
        color: #fecaca;
    }

    body.dark-mode .btn-cancel {
        background: #1e293b;
        border-color: #334155;
        color: #cbd5e1;
    }

    body.dark-mode .btn-cancel:hover {
        background: #263449;
        color: #f1f5f9;
    }
</style>

<div class="container-fluid delete-page">

    <div class="delete-card">

        <!-- Warning Header -->
        <div class="delete-banner">

            <div class="warning-icon">
                ⚠️
            </div>

            <h3>Delete Product?</h3>

            <p>
                Please review the product information before confirming.
            </p>

        </div>

        <!-- Content -->
        <div class="delete-content">

            <div class="warning-message">
                <strong>Warning:</strong>
                This action cannot be undone. The selected product will be permanently deleted.
            </div>

            <!-- Product Information -->
            <div class="product-details">

                <div class="product-details-header">

                    <div class="product-avatar">
                        📦
                    </div>

                    <div>
                        <h5>@Model.Name</h5>
                        <small>Product ID: #@Model.Id</small>
                    </div>

                </div>

                <div class="details-list">

                    <div class="detail-row">
                        <span class="detail-label">Category</span>
                        <span class="detail-value">
                            @(Model.Category?.Name ?? "No Category")
                        </span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Price</span>
                        <span class="detail-value">
                            @Model.Price.ToString("N2") TND
                        </span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Available Quantity</span>
                        <span class="detail-value">
                            @Model.Quantity
                        </span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Minimum Stock</span>
                        <span class="detail-value">
                            @Model.MinimumStock
                        </span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Created Date</span>
                        <span class="detail-value">
                            @Model.CreatedAt.ToString("dd/MM/yyyy")
                        </span>
                    </div>

                </div>

            </div>

            <!-- Confirmation -->
            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="delete-actions">

                    <a asp-action="Index" class="btn-cancel">
                        ← No, Keep Product
                    </a>

                    <button type="submit" class="btn-delete">
                        🗑️ Yes, Delete Product
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
