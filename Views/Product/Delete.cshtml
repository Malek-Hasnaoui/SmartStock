@model SmartStock.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-5">
    <div class="card shadow border-0 rounded-4 mx-auto"
         style="max-width:600px">

        <div class="card-body p-5 text-center">

            <div style="font-size:60px">⚠️</div>

            <h3 class="fw-bold mt-3">Delete Product?</h3>

            <p class="text-muted">
                Are you sure you want to delete this product?
                This action cannot be undone.
            </p>

            <div class="bg-light rounded-3 p-3 my-4 text-start">
                <h5 class="fw-bold">@Model.Name</h5>

                <p class="mb-1">
                    Category: @(Model.Category?.Name ?? "No Category")
                </p>

                <p class="mb-1">
                    Price: @Model.Price.ToString("N2")
                </p>

                <p class="mb-0">
                    Quantity: @Model.Quantity
                </p>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger px-4">
                    🗑️ Yes, Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    Cancel
                </a>
            </form>

        </div>
    </div>
</div>
